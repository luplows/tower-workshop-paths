* text=auto eol=lf

# Vitest snapshots are generated output, not hand-written source. Marking them
# as generated collapses them in GitHub diffs, so a PR that regenerates data
# reads as the logic it actually changed rather than thousands of churned lines.
*.snap linguist-generated=true

# Screenshot baselines are generated by .github/workflows/update-screenshots.yml
# on a CI runner, not written by hand -- same reasoning as the Vitest snapshots
# above.
e2e/__screenshots__/*.png linguist-generated=true
